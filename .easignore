# Copia las reglas de .gitignore relevantes para no subir basura.
.git
**/node_modules
**/.expo
**/.turbo
*.log

# No subir la copia raíz de Firebase.
Fronted/apps/mobile/google-services.json

# Incluir explícitamente el archivo que Gradle necesita.
!Fronted/apps/mobile/android/app/google-services.json

# Keep backend environment files out of EAS Build uploads.
Backend/**/env
Backend/**/.env
Backend/**/.env.*

# Keep local session data, response dumps and backups out of the repository and build uploads.
/.beeapp-backups/
**/*.bak*
/Backend/beeAppBack/cookies.txt
/Backend/beeAppBack/calendar-integrations.json
/Backend/beeAppBack/google-sync-response.json
/Backend/beeAppBack/google-discover-response.json
/Backend/beeAppBack/beeapp-calendar-events.json
