{
  "expo": {
    "name": "BeeApp AI",
    "slug": "beeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "scheme": "beeapp",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#6025d2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beeapp.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "BeeApp necesita acceso a la cámara para escanear códigos QR de inicio de sesión."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/logo.png",
        "backgroundColor": "#6025d2"
      },
      "package": "com.beeapp.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BeeApp necesita acceso a la cámara para escanear códigos QR de inicio de sesión."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BeeApp necesita usar Face ID para proteger el acceso a tu cuenta."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/logo.png",
          "color": "#6025d2",
          "defaultChannel": "default"
        }
      ],
      "./withMonorepoSettings.js"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c6caf5a7-1c76-4a07-ae51-6307712244be"
      }
    },
    "owner": "gordosaurio"
  }
}