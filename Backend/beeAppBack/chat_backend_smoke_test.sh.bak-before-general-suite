      "$RESPONSE_FILE" \
      "$CURL_ERROR_FILE"

  elif [ "$HTTP_CODE" != "$expected_code" ]; then
    mark_failure \
      "Expected HTTP $expected_code, got HTTP $HTTP_CODE." \
      "$HTTP_CODE" \
      "$RESPONSE_FILE" \
      "$CURL_ERROR_FILE"

