TESTS_PASSED=0
TESTS_FAILED=0
EXPECTED_FAILURES_OK=0
CURRENT_TEST_LABEL=""

HTTP_CODE=""
CURL_EXIT_CODE=0
RESPONSE_FILE=""
CURL_ERROR_FILE=""

mkdir -p "$OUTPUT_DIR"
: > "$REPORT_FILE"
: > "$FAILURES_FILE"


cleanup() {
  rm -f "$TEST_FILE_PATH"

  unset \
    ACCESS_TOKEN_A \
    ACCESS_TOKEN_B \
    USER_A_PASSWORD \
    USER_B_PASSWORD
}
